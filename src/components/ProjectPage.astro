---
import { content, type Lang } from '../i18n/content';
import { url } from '../i18n/url';
import Layout from './Layout.astro';
interface Props { lang: Lang; slug: 'thegame' | 'thesis' }
const { lang, slug } = Astro.props;
const t = content[lang];
const alt = lang === 'es' ? 'en' : 'es';
const page = t.pages[slug];
const extra = ((page as any).links ?? []) as string[][];
const homeHref = lang === 'es' ? '/' : '/en/';
const altHref = content[alt].projects.find((p) => p.slug === slug)!.href;
---
<Layout lang={lang} title={`${page.title} · ${t.name}`} description={page.lead} homeHref={homeHref} altHref={altHref}>
  <article class="case">
    <p class="meta"><a href={url(homeHref)}>{t.back}</a></p>
    <h1>{page.title}</h1>
    <p class="lead">{page.lead}</p>
    <dl class="facts">
      {page.facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
    </dl>
    {extra.length > 0 && (
      <ul class="links page-links">
        {extra.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    )}
    {page.sections.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.paragraphs.map((p) => <p class="text">{p}</p>)}
        {s.figures && (
          <div class="figs">
            {s.figures.map((f) => (
              <figure class={f.wide ? 'wide' : ''}>
                <img src={url(f.src)} alt={f.alt} loading="lazy" />
                <figcaption class="meta">{f.caption}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </section>
    ))}
  </article>
</Layout>

<style is:global>
  .case { padding-top: 2rem; }
  .case h1 { margin: 1rem 0 1.25rem; max-width: 24ch; }
  .lead { font-size: 1.2rem; max-width: 42rem; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1.25rem; margin: 2rem 0 0; padding: 1.25rem 0; border-top: 1px solid var(--trace); border-bottom: 1px solid var(--trace); }
  .facts dt { color: var(--muted); font-size: 0.9rem; }
  .facts dd { margin: 0.15rem 0 0; }
  .page-links { margin-top: 1.25rem; }
  .case section { margin-top: 3.5rem; }
  .text { max-width: 42rem; }
  .figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem; margin-top: 1.5rem; align-items: start; }
  .figs figure { margin: 0; }
  .figs figure.wide { grid-column: 1 / -1; }
  .figs img { width: 100%; height: auto; display: block; border: 1px solid var(--trace); border-radius: 4px; background: var(--deep); }
  .figs figcaption { margin-top: 0.4rem; }
</style>
