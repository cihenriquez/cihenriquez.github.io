---
import { content, skillItems, links, type Lang } from '../i18n/content';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL;
const site = Astro.site?.origin ?? '';
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="alternate" hreflang="es" href={`${site}${base}`} />
    <link rel="alternate" hreflang="en" href={`${site}${base}en/`} />
  </head>
  <body>
    <div class="wrap">
      <header>
        <LanguageSwitcher lang={lang} label={t.switchTo} />
        <h1>{t.name}</h1>
        <p class="role">{t.role}</p>
        <p class="summary">{t.summary}</p>
        <ul class="links">
          <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
          <li><a href={links.linkedin}>LinkedIn</a></li>
          <li><a href={links.github}>GitHub</a></li>
          <li><a href={links.tekknight}>tekknight.io</a></li>
        </ul>
      </header>

      <main>
        <section>
          <h2>{t.experience}</h2>
          {t.jobs.map((j) => (
            <article>
              <h3>{j.role}, {j.company}</h3>
              <p class="meta">{j.period}</p>
              <ul>{j.points.map((p) => <li>{p}</li>)}</ul>
            </article>
          ))}
        </section>

        <section>
          <h2>{t.skills}</h2>
          <dl>
            {skillItems.map((items, i) => (
              <>
                <dt>{t.skillLabels[i]}</dt>
                <dd>{items.join(', ')}</dd>
              </>
            ))}
          </dl>
        </section>

        <section>
          <h2>{t.education}</h2>
          {t.studies.map((s) => (
            <article>
              <h3>{s.title}</h3>
              <p class="meta">{s.place}, {s.period}</p>
              <p>{s.text}</p>
            </article>
          ))}
        </section>

        <section>
          <h2>{t.outside}</h2>
          <p>{t.outsideText}</p>
        </section>
      </main>

      <footer>
        <h2>{t.contact}</h2>
        <p><a href={`mailto:${links.email}`}>{links.email}</a> · {t.location}</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --board: #0f3a2e;
    --ink: #eaf1e8;
    --muted: #a3bcb0;
    --gold: #e3bd5c;
    --trace: #2a5a4b;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--board); color: var(--ink);
    font: 1.05rem/1.65 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .wrap { max-width: 46rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  h1 { font-size: clamp(2.4rem, 8vw, 4rem); line-height: 1.05; margin: 2.5rem 0 0.5rem; letter-spacing: -0.02em; }
  .role { color: var(--gold); font-weight: 600; margin: 0 0 1.25rem; }
  .summary { max-width: 38rem; }
  .links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  a { color: var(--ink); text-underline-offset: 3px; }
  a:hover, a:focus-visible { color: var(--gold); }
  a:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  section { margin-top: 3.5rem; }
  h2 { font-size: 1.3rem; margin: 0 0 1.25rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--trace); }
  h3 { font-size: 1.05rem; margin: 0; }
  article { margin-bottom: 2rem; }
  .meta { font: 0.85rem ui-monospace, 'SF Mono', Consolas, monospace; color: var(--muted); margin: 0.15rem 0 0.5rem; }
  article ul { margin: 0; padding-left: 1.2rem; }
  article li { margin-bottom: 0.35rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem; margin: 0; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  footer { margin-top: 3.5rem; }
  @media (max-width: 34rem) { dl { grid-template-columns: 1fr; gap: 0; } dd { margin-bottom: 0.75rem; } }
</style>
