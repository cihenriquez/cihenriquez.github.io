---
import { content, links, type Lang } from '../i18n/content';
import { url } from '../i18n/url';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { lang: Lang; title: string; description: string; homeHref: string; altHref: string }
const { lang, title, description, homeHref, altHref } = Astro.props;
const t = content[lang];
const alt = lang === 'es' ? 'en' : 'es';
const site = Astro.site?.origin ?? '';
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="alternate" hreflang={alt} href={`${site}${url(altHref)}`} />
    <link rel="preload" href={url('/fonts/LibreBaskerville-VariableFont_wght.ttf')} as="font" type="font/ttf" crossorigin />
    <Fragment set:html={`<style>@font-face{font-family:'Libre Baskerville';src:url(${url('/fonts/LibreBaskerville-VariableFont_wght.ttf')}) format('truetype');font-weight:400 700;font-style:normal;font-display:swap}</style>`} />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <img class="crest" src={url('/crest.svg')} alt="" width="1207" height="1212" decoding="async" />
      <canvas class="traces"></canvas>
    </div>
    <div class="wrap">
      <header class="top">
        <a class="brand" href={url(homeHref)}>{t.name}</a>
        <LanguageSwitcher lang={lang} href={url(altHref)} label={t.switchTo} />
      </header>
      <slot />
      <footer>
        <h2>{t.contactTitle}</h2>
        <ul class="links">
          <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
          <li><a href={links.linkedin}>LinkedIn</a></li>
          <li><a href={links.github}>GitHub</a></li>
          <li><a href={links.tekknight}>tekknight.io</a></li>
        </ul>
        <p class="meta">{t.location}</p>
      </footer>
    </div>
  </body>
</html>

<script>
  import { background } from '../scripts/background';
  background(document.querySelector<HTMLElement>('.bg')!);
</script>

<style is:global>
  :root { --paper: #ffffff; --paper-end: #e3e6e9; --deep: #eef0f2; --ink: #17212b; --muted: #55616d; --accent: #0f5a43; --trace: #c6ccd2; --shadow: 0 2px 6px rgba(23, 33, 43, 0.14); --font: 'Libre Baskerville', Georgia, 'Times New Roman', serif; color-scheme: light; }
  * { box-sizing: border-box; }
  html { background: var(--paper-end); }
  body { margin: 0; position: relative; overflow-x: hidden; min-height: 100vh; background: linear-gradient(180deg, var(--paper) 0%, var(--paper-end) 100%); color: var(--ink); font: 0.98rem/1.75 var(--font); }
  .bg { position: absolute; inset: 0; overflow: hidden; opacity: 0.05; mix-blend-mode: multiply; pointer-events: none; user-select: none; z-index: 0; }
  .crest { position: absolute; top: 0; left: 0; width: 50vw; min-width: 16rem; height: auto; }
  .traces { position: fixed; inset: 0; width: 100%; height: 100%; }
  .wrap { position: relative; z-index: 1; max-width: 56rem; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  a { color: var(--ink); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .brand { font-weight: 700; text-decoration: none; }
  h1 { font-size: clamp(1.7rem, 4.4vw, 2.7rem); line-height: 1.2; letter-spacing: 0; margin: 0; max-width: 22ch; }
  h2 { font-size: 1.15rem; margin: 0 0 1.25rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--trace); }
  h3 { margin: 0 0 0.5rem; font-size: 1.2rem; line-height: 1.35; }
  .meta, .tags { font: 0.8rem/1.6 var(--font); color: var(--muted); }
  .links { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  footer { margin-top: 5rem; }
</style>
